{
  "rules": {
    "realtime": {
      "attendance": {
        "live": {
          "$userId": {
            ".read": "auth != null && auth.uid == $userId",
            ".write": false,
            ".indexOn": ["date", "timestamp", "status"]
          }
        }
      },
      "dashboard": {
        "stats": {
          "$orgId": {
            ".read": "auth != null",
            ".write": false
          }
        }
      },
      "users": {
        "online": {
          "$userId": {
            ".read": "auth != null",
            ".write": false
          }
        }
      },
      "notifications": {
        "$userId": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": false
        }
      },
      "announcements": {
        "$orgId": {
          ".read": "auth != null",
          ".write": false
        }
      },
      "gamification": {
        "leaderboard": {
          "$orgId": {
            ".read": "auth != null",
            ".write": false
          }
        }
      },
      "admin": {
        "monitor": {
          "$orgId": {
            ".read": "auth != null && auth.token.admin === true",
            ".write": false
          }
        }
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null && (auth.uid == $userId || auth.token.admin === true)",
        ".write": false
      }
    },
    "attendance": {
      ".read": false,
      ".write": false
    },
    "admins": {
      ".read": false,
      ".write": false
    },
    "adminTokens": {
      ".read": false,
      ".write": false
    },
    "adminRefreshTokens": {
      ".read": false,
      ".write": false
    },
    "auditLogs": {
      ".read": false,
      ".write": false
    },
    "sessions": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": false
      }
    },
    "systemSettings": {
      ".read": "auth != null",
      ".write": false
    },
    "announcements": {
      ".read": "auth != null",
      ".write": false
    },
    "mfaSessions": {
      ".read": false,
      ".write": false
    },
    "departments": {
      ".read": "auth != null",
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
