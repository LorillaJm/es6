# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials to version control
# ============================================

# ============================================
# MONGODB ATLAS CONFIGURATION (PRIMARY DATABASE)
# ============================================
# Get connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_database?retryWrites=true&w=majority

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Firebase Client (Public) - Safe to expose
PUBLIC_FIREBASE_API_KEY=your_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_DATABASE_URL=https://your_project.firebasedatabase.app
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Private) - KEEP SECRET
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Option 1: Paste JSON as single line (not recommended for production)
# Option 2: Use separate file and reference path (recommended)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Resend (recommended for production)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Your App <noreply@yourdomain.com>

# Gmail SMTP (fallback)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ============================================
# OAUTH CONFIGURATION (Optional)
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your_client_id
MICROSOFT_CLIENT_SECRET=your_client_secret

# Slack OAuth
SLACK_CLIENT_ID=your_client_id
SLACK_CLIENT_SECRET=your_client_secret

# Zoom OAuth
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# ============================================
# AI CONFIGURATION (Optional)
# ============================================
# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# ============================================
# FEATURE FLAGS
# ============================================
PUBLIC_GEOFENCE_ENABLED=true
PUBLIC_GEOFENCE_STRICT_MODE=false
PUBLIC_AI_ANALYSIS_ENABLED=true
PUBLIC_AI_BLOCK_CRITICAL=true
PUBLIC_OFFLINE_SYNC_INTERVAL=30000
PUBLIC_SESSION_TIMEOUT_HOURS=8
